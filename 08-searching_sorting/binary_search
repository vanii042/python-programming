numbers = list(map(int, input("Enter sorted numbers: ").split()))
target = int(input("Target: "))
left, right = 0, len(numbers)-1
found = -1
while left <= right:
    mid = (left + right)//2
    if numbers[mid] == target: found = mid; break
    elif numbers[mid] < target: left = mid + 1
    else: right = mid - 1
print("Index:", found if found != -1 else "Not found")
