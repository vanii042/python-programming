class Node:
    def __init__(self, data): self.data, self.next = data, None
class LinkedList:
    def __init__(self): self.head = None
    def append(self, data):
        node = Node(data)
        if not self.head: self.head = node; return
        current = self.head
        while current.next: current = current.next
        current.next = node
    def display(self):
        current = self.head
        while current: print(current.data, end=" -> "); current = current.next
        print("None")
items = LinkedList()
for value in [10, 20, 30]: items.append(value)
items.display()
