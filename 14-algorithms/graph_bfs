from collections import deque
graph = {0: [1, 2], 1: [0, 3], 2: [0, 3], 3: [1, 2]}
def bfs(start):
    visited, queue = {start}, deque([start])
    while queue:
        node = queue.popleft()
        print(node, end=" ")
        for neighbor in graph[node]:
            if neighbor not in visited: visited.add(neighbor); queue.append(neighbor)
bfs(0)
print()
